+                log.WriteLine("# 逃逸键触发");
+                // 放弃路径也必须通知设备侧清状态：接管期间若按着鼠标键/修饰键再逃逸，
+                // 不补发 LEAVE 会让手机侧 buttonsDown 与按键槽位永久残留（leave 才会清）。
+                // 设备侧处理 MSG_LEAVE 时会 buttonsDown=0 并 KeyState.releaseAll。
+                transport.Send(Protocol.EncodeLeave());
+                tracker.AbortTakeover();
+                supp.Release();
+                host.SetStatus("IDLE");
+            };
